+defmodule SymphonyElixir.QueueIdleTest do
+  use SymphonyElixir.TestSupport
+
+  alias SymphonyElixir.Config.Schema.Hooks
+
+  setup do
+    root = Path.join(System.tmp_dir!(), "symphony-queue-idle-#{System.unique_integer([:positive])}")
+    File.mkdir_p!(root)
+    on_exit(fn -> File.rm_rf(root) end)
+    {:ok, root: root}
+  end
+
+  test "idle exit code is optional and validates the nonzero process exit range" do
+    assert Hooks.changeset(%Hooks{}, %{}).valid?
+    assert Hooks.changeset(%Hooks{}, %{"before_run_idle_exit_code" => 75}).valid?
+
+    for invalid <- [0, -1, 256, "invalid"] do
+      refute Hooks.changeset(%Hooks{}, %{"before_run_idle_exit_code" => invalid}).valid?
+    end
+  end
+
+  test "only an opted-in before_run exit becomes idle", %{root: root} do
+    configure(root, hook_before_run: "exit 75")
+    assert {:idle, :unchanged} = Workspace.run_before_run_hook(root, "GH-27")
+  end
+
+  test "default exit 75 and pending or error exits remain failures", %{root: root} do
+    configure(root, [hook_before_run: "exit 75"], false)
+
+    assert {:error, {:workspace_hook_failed, "before_run", 75, _}} =
+             Workspace.run_before_run_hook(root, "GH-27")
+
+    for status <- [1, 2, 74] do
+      configure(root, hook_before_run: "exit #{status}")
+
+      assert {:error, {:workspace_hook_failed, "before_run", ^status, _}} =
+               Workspace.run_before_run_hook(root, "GH-27")
+    end
+  end
+
+  test "opt in does not make after_create exit 75 idle", %{root: root} do
+    configure(root, hook_after_create: "exit 75")
+
+    assert {:error, {:workspace_hook_failed, "after_create", 75, _}} =
+             Workspace.create_for_issue(issue())
+  end
+
+  test "idle runner starts no model and never executes after_run", %{root: root} do
+    model_marker = Path.join(root, "model-started")
+    after_marker = Path.join(root, "after-run")
+
+    configure(root,
+      hook_before_run: "exit 75",
+      hook_after_run: "touch '#{after_marker}'",
+      codex_command: "touch '#{model_marker}'; exit 23"
+    )
+
+    {pid, ref} = spawn_monitor(fn -> AgentRunner.run(issue()) end)
+    assert_receive {:DOWN, ^ref, :process, ^pid, {:shutdown, :idle}}, 2_000
+    refute File.exists?(model_marker)
+    refute File.exists?(after_marker)
+  end
+
+  test "idle shutdown releases claim without completion or retry and permits the next poll", %{root: root} do
+    configure(root, hook_before_run: "exit 75")
+    issue = issue()
+    ref = make_ref()
+
+    state = %Orchestrator.State{
+      max_concurrent_agents: 1,
+      codex_totals: %{},
+      running: %{issue.id => %{pid: self(), ref: ref, identifier: issue.identifier, issue: issue, started_at: DateTime.utc_now()}},
+      claimed: MapSet.new([issue.id]),
+      retry_attempts: %{}
+    }
+
+    {:noreply, idle} = Orchestrator.handle_info({:DOWN, ref, :process, self(), {:shutdown, :idle}}, state)
+    assert idle.running == %{}
+    assert idle.retry_attempts == %{}
+    refute MapSet.member?(idle.completed, issue.id)
+    refute MapSet.member?(idle.claimed, issue.id)
+    assert idle.blocked == %{}
+    assert Orchestrator.should_dispatch_issue_for_test(issue, idle)
+
+    Application.put_env(:symphony_elixir, :memory_tracker_issues, [issue])
+    {:ok, supervisor} = Task.Supervisor.start_link()
+    {:noreply, polled} = Orchestrator.handle_info(:run_poll_cycle, %{idle | task_supervisor: supervisor})
+    assert Map.has_key?(polled.running, issue.id)
+    assert MapSet.member?(polled.claimed, issue.id)
+    Process.cancel_timer(polled.tick_timer_ref)
+    worker = polled.running[issue.id]
+    assert_receive {:DOWN, worker_ref, :process, worker_pid, {:shutdown, :idle}}, 2_000
+    assert worker_ref == worker.ref
+    assert worker_pid == worker.pid
+  end
+
+  defp configure(root, overrides, idle? \\ true) do
+    path = Workflow.workflow_file_path()
+    write_workflow_file!(path, Keyword.merge([tracker_kind: "memory", workspace_root: root], overrides))
+
+    if idle? do
+      File.write!(path, String.replace(File.read!(path), "hooks:\n", "hooks:\n  before_run_idle_exit_code: 75\n"))
+      WorkflowStore.force_reload()
+    end
+  end
+
+  defp issue do
+    %Issue{id: "queue-idle", identifier: "GH-27", title: "Queue idle", state: "In Progress", dispatchable: true}
+  end
+end
